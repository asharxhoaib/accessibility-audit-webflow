WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WEBFLOW_REDIRECT_URI=http://localhost:3000/oauth/callback
WEBFLOW_SCOPES=pages:read,pages:write,cms:read,sites:read,assets:read

# Public https base URL Webflow can reach (use your ngrok https URL during local dev). Used for webhook URLs.
APP_PUBLIC_URL=http://localhost:3000

# Passphrase used to derive the AES-256-GCM key that encrypts stored OAuth tokens
TOKEN_ENCRYPTION_KEY=change-me-in-production

# Scheduled audits: how often (minutes) the scheduler looks for sites due an audit, and how old the last run must be (hours)
SCHEDULE_CHECK_INTERVAL_MIN=60
AUTO_AUDIT_EVERY_HOURS=24
# Delay (seconds) between a site_publish webhook and the audit it triggers (lets the CDN catch up)
PUBLISH_AUDIT_DELAY_SEC=45
# Audit runs kept per site (older runs and their findings are pruned)
RUN_RETENTION_COUNT=60
# Safety cap on pages audited per run
MAX_PAGES_PER_RUN=200

DATABASE_PATH=./db/audit.sqlite
PORT=3000
